{
  "name": "auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:authz": "vitest run --project unit --coverage --coverage.include=src/lib/authz.ts src/lib/authz",
    "test:watch": "vitest",
    "seed": "prisma db seed",
    "e2e": "playwright test",
    "e2e:build": "next build && next build e2e/product-stub",
    "bench:auth-timing": "node scripts/auth-timing-bench.mjs",
    "prisma:migrate-dev": "node scripts/prisma-guard.mjs migrate dev && prisma migrate dev",
    "prisma:migrate-reset": "node scripts/prisma-guard.mjs migrate reset && prisma migrate reset",
    "prisma:db-push": "node scripts/prisma-guard.mjs db push && prisma db push",
    "positions:sync": "tsx scripts/positions-sync.ts",
    "validate-export": "tsx scripts/validate-export.ts",
    "import:users": "tsx scripts/import-users.ts",
    "import:aplio": "tsx scripts/import-aplio-users.ts",
    "import:slack-links": "tsx scripts/import-slack-links.ts",
    "reconcile:aplio": "tsx scripts/reconcile-aplio.ts",
    "email:preview": "tsx scripts/email-preview.ts",
    "jwks:rotate": "tsx scripts/jwks-rotate.ts",
    "supabase:push-jwks": "tsx scripts/supabase-push-jwks.ts",
    "bootstrap-primary-admin": "tsx scripts/bootstrap-primary-admin.ts",
    "recover-primary-admin": "tsx --conditions=react-server scripts/recover-primary-admin.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@better-auth/core": "1.7.7",
    "@better-auth/passkey": "1.7.7",
    "@better-auth/prisma-adapter": "^1.7.7",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "jose": "6.2.12",
    "lucide-react": "^1.7.0",
    "next": "16.4.3",
    "pg": "^8.20.0",
    "posthog-node": "^5.57.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nusgaops/sgauth": "0.2.0",
    "@playwright/test": "1.64.1",
    "@simplewebauthn/server": "13.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "neonctl": "8.4.4",
    "prettier": "^3.8.1",
    "prisma": "^7.10.0",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.6"
  }
}
