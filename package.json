    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "neonctl": "8.4.4",
    "prettier": "^3.8.1",
    "prisma": "^7.10.0",
