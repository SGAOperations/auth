{
  "name": "auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "seed": "prisma db seed",
    "prisma:migrate-dev": "node scripts/prisma-guard.mjs migrate dev && prisma migrate dev",
