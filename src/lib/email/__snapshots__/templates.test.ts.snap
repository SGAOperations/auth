exports[`rendering > renders account-locked with a subject, html and text 1`] = `
{
  "html": "<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Your account was locked</title></head>
<body style="margin:0;padding:0;background:#f5f7fa;">
<div style="display:none;max-height:0;overflow:hidden;">Sign-in to your account is locked for now.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7fa;"><tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:8px;">
<tr><td style="font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;letter-spacing:1px;color:#c8102e;padding:24px 32px 0;">SGA Auth</td></tr>
<tr><td style="padding:16px 32px 8px;"><h1 style="font-family:Arial,Helvetica,sans-serif;font-size:22px;line-height:28px;color:#102a43;margin:0 0 16px;">Your account was locked</h1>
<p style="font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;color:#1f2933;margin:0 0 16px;">Hi Avery,</p><p style="font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;color:#1f2933;margin:0 0 16px;">We locked sign-in to your account after repeated failed attempts. It unlocks automatically at October 17, 2026 at 3:00 PM ET, or use the unlock link we sent separately. If this wasn&#39;t you, reset your password.</p>


</td></tr>
<tr><td style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#7b8794;padding:16px 32px 24px;border-top:1px solid #e4e7eb;">Sent by SGA Auth, the sign-in for Northeastern SGA tools. Replies to this address aren&#39;t read.</td></tr>
</table></td></tr></table></body></html>",
  "subject": "Your SGA account was locked",
  "text": "SGA Auth

Your account was locked

Hi Avery,

We locked sign-in to your account after repeated failed attempts. It unlocks automatically at October 17, 2026 at 3:00 PM ET, or use the unlock link we sent separately. If this wasn't you, reset your password.

--
Sent by SGA Auth, the sign-in for Northeastern SGA tools. Replies to this address aren't read.",
}
`;

exports[`rendering > renders account-unlock with a subject, html and text 1`] = `
{
  "html": "<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Unlock your account</title></head>
<body style="margin:0;padding:0;background:#f5f7fa;">
<div style="display:none;max-height:0;overflow:hidden;">Use this link to unlock your account.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7fa;"><tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:8px;">
<tr><td style="font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;letter-spacing:1px;color:#c8102e;padding:24px 32px 0;">SGA Auth</td></tr>
<tr><td style="padding:16px 32px 8px;"><h1 style="font-family:Arial,Helvetica,sans-serif;font-size:22px;line-height:28px;color:#102a43;margin:0 0 16px;">Unlock your account</h1>
<p style="font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;color:#1f2933;margin:0 0 16px;">Hi Avery,</p><p style="font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;color:#1f2933;margin:0 0 16px;">Use this link to unlock your SGA account. The link works once and expires in 1 hour.</p>
<p style="margin:8px 0 24px;"><a href="https://auth.northeasternsga.com/unlock?token=sample" style="font-family:Arial,Helvetica,sans-serif;display:inline-block;background:#c8102e;color:#ffffff;font-size:16px;font-weight:bold;text-decoration:none;padding:12px 24px;border-radius:6px;">Unlock account</a></p><p style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#52606d;margin:0 0 16px;">If the button doesn't work, copy this link:<br><a href="https://auth.northeasternsga.com/unlock?token=sample" style="color:#52606d;word-break:break-all;">https://auth.northeasternsga.com/unlock?token=sample</a></p>

</td></tr>
<tr><td style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#7b8794;padding:16px 32px 24px;border-top:1px solid #e4e7eb;">Sent by SGA Auth, the sign-in for Northeastern SGA tools. Replies to this address aren&#39;t read.</td></tr>
</table></td></tr></table></body></html>",
  "subject": "Unlock your SGA account",
  "text": "SGA Auth

Unlock your account

Hi Avery,

Use this link to unlock your SGA account. The link works once and expires in 1 hour.

Unlock account:
https://auth.northeasternsga.com/unlock?token=sample

--
Sent by SGA Auth, the sign-in for Northeastern SGA tools. Replies to this address aren't read.",
}
`;

exports[`rendering > renders inactivity-notice with a subject, html and text 1`] = `
{
  "html": "<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sign in to keep your account</title></head>
<body style="margin:0;padding:0;background:#f5f7fa;">
<div style="display:none;max-height:0;overflow:hidden;">Your account will be deleted if you don&#39;t sign in.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7fa;"><tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:8px;">
<tr><td style="font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;letter-spacing:1px;color:#c8102e;padding:24px 32px 0;">SGA Auth</td></tr>
<tr><td style="padding:16px 32px 8px;"><h1 style="font-family:Arial,Helvetica,sans-serif;font-size:22px;line-height:28px;color:#102a43;margin:0 0 16px;">Sign in to keep your account</h1>
<p style="font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;color:#1f2933;margin:0 0 16px;">Hi Avery,</p><p style="font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;color:#1f2933;margin:0 0 16px;">You haven&#39;t signed in since April 16, 2026 at 3:00 PM ET. If you don&#39;t sign in before October 23, 2026 at 3:00 PM ET, your account will be deleted.</p>
<p style="margin:8px 0 24px;"><a href="https://auth.northeasternsga.com/sign-in" style="font-family:Arial,Helvetica,sans-serif;display:inline-block;background:#c8102e;color:#ffffff;font-size:16px;font-weight:bold;text-decoration:none;padding:12px 24px;border-radius:6px;">Sign in</a></p><p style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#52606d;margin:0 0 16px;">If the button doesn't work, copy this link:<br><a href="https://auth.northeasternsga.com/sign-in" style="color:#52606d;word-break:break-all;">https://auth.northeasternsga.com/sign-in</a></p>

</td></tr>
<tr><td style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#7b8794;padding:16px 32px 24px;border-top:1px solid #e4e7eb;">Sent by SGA Auth, the sign-in for Northeastern SGA tools. Replies to this address aren&#39;t read.</td></tr>
</table></td></tr></table></body></html>",
  "subject": "Sign in to keep your SGA account",
  "text": "SGA Auth

Sign in to keep your account

Hi Avery,

You haven't signed in since April 16, 2026 at 3:00 PM ET. If you don't sign in before October 23, 2026 at 3:00 PM ET, your account will be deleted.

Sign in:
https://auth.northeasternsga.com/sign-in

--
Sent by SGA Auth, the sign-in for Northeastern SGA tools. Replies to this address aren't read.",
}
`;

exports[`rendering > renders pa-transfer-accepted-initiator with a subject, html and text 1`] = `
{
  "html": "<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Primary Admin transfer accepted</title></head>
<body style="margin:0;padding:0;background:#f5f7fa;">
<div style="display:none;max-height:0;overflow:hidden;">Sam Rivera accepted the transfer.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7fa;"><tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:8px;">
<tr><td style="font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;letter-spacing:1px;color:#c8102e;padding:24px 32px 0;">SGA Auth</td></tr>
<tr><td style="padding:16px 32px 8px;"><h1 style="font-family:Arial,Helvetica,sans-serif;font-size:22px;line-height:28px;color:#102a43;margin:0 0 16px;">Primary Admin transfer accepted</h1>
<p style="font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;color:#1f2933;margin:0 0 16px;">Hi,</p><p style="font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;color:#1f2933;margin:0 0 16px;">Sam Rivera accepted. The transfer completes at October 17, 2026 at 3:00 PM ET.</p><p style="font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;color:#1f2933;margin:0 0 16px;">You can cancel until then.</p>
<p style="margin:8px 0 24px;"><a href="https://auth.northeasternsga.com/admin/transfer" style="font-family:Arial,Helvetica,sans-serif;display:inline-block;background:#c8102e;color:#ffffff;font-size:16px;font-weight:bold;text-decoration:none;padding:12px 24px;border-radius:6px;">Cancel transfer</a></p><p style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#52606d;margin:0 0 16px;">If the button doesn't work, copy this link:<br><a href="https://auth.northeasternsga.com/admin/transfer" style="color:#52606d;word-break:break-all;">https://auth.northeasternsga.com/admin/transfer</a></p>

</td></tr>
<tr><td style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#7b8794;padding:16px 32px 24px;border-top:1px solid #e4e7eb;">Sent by SGA Auth, the sign-in for Northeastern SGA tools. Replies to this address aren&#39;t read.</td></tr>
</table></td></tr></table></body></html>",
  "subject": "Primary Admin transfer accepted",
  "text": "SGA Auth

Primary Admin transfer accepted

Hi,

Sam Rivera accepted. The transfer completes at October 17, 2026 at 3:00 PM ET.

You can cancel until then.

Cancel transfer:
https://auth.northeasternsga.com/admin/transfer

--
Sent by SGA Auth, the sign-in for Northeastern SGA tools. Replies to this address aren't read.",
}
`;

