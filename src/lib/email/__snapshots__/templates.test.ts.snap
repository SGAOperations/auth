exports[`rendering > renders set-password-admin-invite with a subject, html and text 1`] = `
{
  "html": "<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>You&#39;ve been invited</title></head>
<body style="margin:0;padding:0;background:#f5f7fa;">
<div style="display:none;max-height:0;overflow:hidden;">Set a password to finish setting up your account.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7fa;"><tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:8px;">
<tr><td style="font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;letter-spacing:1px;color:#c8102e;padding:24px 32px 0;">SGA Auth</td></tr>
<tr><td style="padding:16px 32px 8px;"><h1 style="font-family:Arial,Helvetica,sans-serif;font-size:22px;line-height:28px;color:#102a43;margin:0 0 16px;">You&#39;ve been invited</h1>
<p style="font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;color:#1f2933;margin:0 0 16px;">Hi Avery,</p><p style="font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;color:#1f2933;margin:0 0 16px;">An SGA admin set up an account for you.</p><p style="font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;color:#1f2933;margin:0 0 16px;">Your account is ready, but it has no password yet.</p><p style="font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:24px;color:#1f2933;margin:0 0 16px;">The link expires in 7 days.</p>
<p style="margin:8px 0 24px;"><a href="https://auth.northeasternsga.com/set-password?token=sample" style="font-family:Arial,Helvetica,sans-serif;display:inline-block;background:#c8102e;color:#ffffff;font-size:16px;font-weight:bold;text-decoration:none;padding:12px 24px;border-radius:6px;">Set password</a></p><p style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#52606d;margin:0 0 16px;">If the button doesn't work, copy this link:<br><a href="https://auth.northeasternsga.com/set-password?token=sample" style="color:#52606d;word-break:break-all;">https://auth.northeasternsga.com/set-password?token=sample</a></p>

</td></tr>
<tr><td style="font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#7b8794;padding:16px 32px 24px;border-top:1px solid #e4e7eb;">Sent by SGA Auth, the sign-in for Northeastern SGA tools. Replies to this address aren&#39;t read.</td></tr>
</table></td></tr></table></body></html>",
  "subject": "You've been invited to SGA Auth",
  "text": "SGA Auth

You've been invited

Hi Avery,

An SGA admin set up an account for you.

Your account is ready, but it has no password yet.

The link expires in 7 days.

Set password:
https://auth.northeasternsga.com/set-password?token=sample

--
Sent by SGA Auth, the sign-in for Northeastern SGA tools. Replies to this address aren't read.",
}
`;

