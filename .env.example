# Neon Postgres (pooled) connection string
# Used by the application at runtime (src/lib/prisma.ts, prisma/seed.ts), as the RUNTIME role (DML only, no DDL).
# The host contains "-pooler". Never commit real credentials; the real values
# live in Vercel env and the team password manager.
DATABASE_URL="postgresql://runtime:REPLACE_ME@ep-example-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=verify-full"

# Neon Postgres direct connection string
# Used by the Prisma CLI through prisma.config.ts (migrate dev / deploy / reset, db push, studio), as the MIGRATION role (owns the schema, DDL).
# The host does NOT contain "-pooler".
DIRECT_URL="postgresql://migration:REPLACE_ME@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=verify-full"

# SGAuth environment: production | dev | preview | local
# Selects the Better Auth baseURL. Required, the server refuses to start without it
SGAUTH_ENV="local"

# Better Auth secret, 32+ characters
# Generate with `npx @better-auth/cli secret`, use a different value per
# environment, and never prefix it with NEXT_PUBLIC_
BETTER_AUTH_SECRET=""
