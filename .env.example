# Neon Postgres (pooled) connection string
# Used by the application at runtime, as the RUNTIME role (DML only, no DDL).
# The host contains "-pooler". Never commit real credentials; the real values
# live in Vercel env and the team password manager.
DATABASE_URL="postgresql://sgauth_runtime:REPLACE_ME@ep-example-123456-pooler.us-east-1.aws.neon.tech/sgauth?sslmode=verify-full"

# Neon Postgres direct connection string
# Used by Prisma for migrations, as the MIGRATION role (owns the schema, DDL).
# The host does NOT contain "-pooler".
DIRECT_URL="postgresql://sgauth_migrate:REPLACE_ME@ep-example-123456.us-east-1.aws.neon.tech/sgauth?sslmode=verify-full"

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"

# Supabase anonymous (public) key
# Safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_XXX"

# Supabase service role key
# Secret key, never expose to the client
SUPABASE_SERVICE_ROLE_KEY="sb_secret_XXX"
