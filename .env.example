# Neon pooled connection string (host contains "-pooler")
# Runtime connection, used by src/lib/prisma.ts and prisma/seed.ts
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=verify-full"

# Neon direct connection string (same host without "-pooler")
# Used by the Prisma CLI through prisma.config.ts: migrate dev / deploy / reset, db push, studio
DIRECT_URL="postgresql://USER:PASSWORD@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=verify-full"

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"

# Supabase anonymous (public) key
# Safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_XXX"

# Supabase service role key
# Secret key, never expose to the client
SUPABASE_SERVICE_ROLE_KEY="sb_secret_XXX"
