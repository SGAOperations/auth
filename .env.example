# SGAuth environment: production | dev | preview | local. Required everywhere; selects the base URL.
SGAUTH_ENV="local"

# Optional log level: debug | info | warn | error | silent. Defaults by SGAUTH_ENV (production and dev info, preview and local debug).
LOG_LEVEL=""

# Pooled Neon URL (host has "-pooler"), RUNTIME role, used by src/lib/prisma.ts and prisma/seed.ts. Required everywhere.
DATABASE_URL="postgresql://runtime:REPLACE_ME@ep-example-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=verify-full"

# Direct Neon URL (no "-pooler"), MIGRATION role, used by the Prisma CLI through prisma.config.ts. Required for migrations, never read by the app.
DIRECT_URL="postgresql://migration:REPLACE_ME@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=verify-full"

# Better Auth secret, 32+ characters (generate with `npx @better-auth/cli secret`). Required everywhere; one value per environment, never NEXT_PUBLIC_.
BETTER_AUTH_SECRET=""

# Optional, local only: comma-separated extra Neon hosts or endpoint IDs that the Prisma guard refuses for migrate dev, migrate reset and db push. Adds to the built-in main and dev protection. Never set in Vercel.
# SGAUTH_PROTECTED_DB_HOSTS=""

# Set by Vercel (production | preview | development); read only by the startup cookie assertion, which refuses SGAUTH_ENV=local on Vercel. Never set by hand.
# VERCEL_ENV=""

# Set by Vercel; read only on preview to derive the base URL. Never set by hand.
# VERCEL_BRANCH_URL=""

# Set by Vercel; read only on preview as the fallback for VERCEL_BRANCH_URL. Never set by hand.
# VERCEL_URL=""

# Comma-separated exact emails and/or @domain entries allowed to sign up. Enforced outside production (empty means nobody); ignored in production.
SGAUTH_SIGNUP_ALLOWLIST=""

# Preview gate password, 16+ characters. Required on dev and preview unless SGAUTH_PREVIEW_GATE=off; ignored elsewhere; never NEXT_PUBLIC_.
SGAUTH_PREVIEW_GATE_PASSWORD=""

# Set to "off" to disable the preview gate explicitly on dev and preview. Optional.
SGAUTH_PREVIEW_GATE=""

# Content-Security-Policy mode: report-only | enforce. Defaults to report-only; flip per Vercel environment to enforce after a clean week of csp_violation logs.
SGAUTH_CSP_MODE="report-only"

# Resend API key for transactional email (the SGAuth account, a sending-only key restricted to auth.northeasternsga.com). Required on production and dev; optional on preview (sends are discarded) and local (emails print to the console). Set together with RESEND_FROM_EMAIL.
RESEND_API_KEY=""

# Bare sender address, e.g. no-reply@auth.northeasternsga.com; the "SGAuth" display name is added in code. Required on production and dev; optional on preview and local. Set together with RESEND_API_KEY.
RESEND_FROM_EMAIL=""

# Optional global daily send cap (default 500); set it to the Resend plan's daily limit or lower. An alert logs at 80%.
SGAUTH_EMAIL_DAILY_CAP=""

# Upstash Redis REST URL for rate limiting. Required on production and dev; optional on preview and local, where limits fall back to a per-instance in-memory store. Set together with the token.
UPSTASH_REDIS_REST_URL=""

# Upstash Redis REST token for rate limiting. Required on production and dev; optional on preview and local, where limits fall back to a per-instance in-memory store. Set together with the URL.
UPSTASH_REDIS_REST_TOKEN=""

# PostHog project key for analytics. Optional until the PostHog ticket lands; set together with POSTHOG_HOST.
POSTHOG_KEY=""

# PostHog ingestion host URL. Optional until the PostHog ticket lands; set together with POSTHOG_KEY.
POSTHOG_HOST=""

# Bearer secret for /api/jobs/*, 32+ characters. Required on production and dev.
CRON_SECRET=""

# CI only (GitHub Actions secret). Never set in Vercel; the app never reads it.
# NEON_API_KEY=""

# Test harness only (npm test). Pooled and direct URLs (migration role) of your personal dev-<name> Neon branch. Rows are deleted from every table before each database test file (append-only tables and the Primary Admin row are left alone), and migrations are applied automatically. Never the main, dev or test branch, and never the same value as DATABASE_URL / DIRECT_URL.
TEST_DATABASE_URL=""
TEST_DIRECT_URL=""

# Local only: email of the Primary Admin that npm run seed creates. Refused unless SGAUTH_ENV=local; set together with the password.
SEED_PRIMARY_ADMIN_EMAIL=""

# Local only: that account's password, 12-128 characters. Applied only when the account has no password yet. Never set in a deployed environment.
SEED_PRIMARY_ADMIN_PASSWORD=""

# Local only, optional: display name for that account (default "Local Primary Admin").
SEED_PRIMARY_ADMIN_NAME=""
