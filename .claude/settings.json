{
  "env": {
    "DIRECT_URL": "postgresql://placeholder"
  },
  "permissions": {
    "allow": [
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(npm *)",
      "Skill",
      "Bash(grep)",
      "Bash(grep *)",
      "Bash(find)",
      "Bash(find *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(wc)",
      "Bash(wc *)",
      "Bash(pwd)",
      "Bash(pwd *)",
      "Bash(mkdir -p *)",
      "Edit(**)",
      "Write(**)",
      "Read(~/.claude/plugins/**)",
      "WebFetch(domain:code.claude.com)",
      "Bash(npx tsc *)",
      "Bash(node scripts/port-artifacts.mjs *)",
      "Bash(node scripts/port-worktrees.mjs *)",
      "Bash(node scripts/port-budget.mjs *)",
      "Bash(node --test scripts/*.test.mjs)",
      "Bash(npx --no-install prisma generate)",
      "Bash(npx --no-install prisma migrate diff *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh issue delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh auth *)",
      "Bash(git push * dev)",
      "Bash(git push origin dev)",
      "Bash(git push *:dev)",
      "Bash(git push * main)",
      "Bash(git push origin main)",
      "Bash(git push *:main)",
      "Bash(npm publish *)",
      "Bash(npm login *)",
      "Bash(npm adduser *)",
      "Bash(find * -exec *)",
      "Bash(find * -execdir *)",
      "Bash(find * -delete*)",
      "Bash(find * -ok *)",
      "Bash(find * -okdir *)",
      "Bash(find -exec *)",
      "Bash(find -execdir *)",
      "Bash(find -delete*)",
      "Bash(find -ok *)",
      "Bash(find -okdir *)"
    ]
  },
  "enabledPlugins": {
    "port@port": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "neon@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "auth-skills@better-auth-agent-skills": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "port": {
      "source": {
        "source": "github",
        "repo": "b-at-neu/port",
        "ref": "v0.4.0"
      },
      "autoUpdate": true
    },
    "better-auth-agent-skills": {
      "source": {
        "source": "github",
        "repo": "better-auth/skills"
      }
    }
  }
}
